# SPDX-License-Identifier: GPL-2.0-only
# Merge after the arm64 defconfig and the instantnoodlep K3 configuration.
# Built-in dependencies allow SLPI service discovery without rootfs modules.
# QCOM_PDR_HELPERS is promptless and select-driven (SLIMBUS, APR/GPR), so it
# cannot be forced here; qcom_q6v5_pas does not reference it.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
