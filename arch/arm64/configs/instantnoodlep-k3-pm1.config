# Diagnostic PM candidate overlay for the slim-all configuration.
#
# Select TEO as the only built-in cpuidle governor for this A/B candidate.
CONFIG_CPU_IDLE_GOV_TEO=y
# CONFIG_CPU_IDLE_GOV_MENU is not set

# Keep Qualcomm low-power-domain statistics available without module loading.
CONFIG_QCOM_STATS=y

CONFIG_LOCALVERSION="-instantnoodlep-k3-pm1"
CONFIG_LOCALVERSION_AUTO=y
